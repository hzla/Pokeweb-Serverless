{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "White 2 live field scene, version 1",
  "description": "Ordered W2 field actions and optional parallel NPC tracks. Prelude cries, shakes, dialogue and holds can precede the first camera move. Environment, tree and actor frame/coordinate checks run during export. The stream duration matches the camera tour after the prelude. STRM bytes are a separate project asset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "target",
    "fps",
    "id",
    "name",
    "zoneId",
    "entry",
    "steps"
  ],
  "properties": {
    "format": {
      "const": "pokeweb.field-scene"
    },
    "version": {
      "const": 1
    },
    "target": {
      "const": "W2-US"
    },
    "fps": {
      "const": 30
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "zoneId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32767
