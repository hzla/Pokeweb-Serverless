    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "fflate": "^0.8.3",
    "gifuct-js": "^2.1.2",
    "nitro-fs": "^1.1.1",
    "pngjs": "^7.0.0",
    "three": "^0.184.0",
    "treeforge": "^1.0.3",
    "vite": "^5.4.19"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.184.1",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
