{
  "name": "pokeweb-serverless",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:codex": "vite --mode codex-dev --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc && vite build",
    "test": "vitest run",
    "moveanim:helper": "vite-node scripts/move-animation-helper.ts",
    "moveanim:index": "vite-node scripts/move-animation-index.ts",
    "moveanim:workflow": "vite-node scripts/move-animation-workflow.ts",
    "pokemonanim:helper": "vite-node scripts/pokemon-animation-helper.ts",
    "gen6sprites:pipeline": "vite-node scripts/gen6-sprite-pipeline.ts",
    "virtualsprite:build": "vite-node scripts/build-virtual-sprite-asset.ts",
    "pwan:library": "vite-node scripts/build-pwan-library.ts",
    "pwan:gif:inspect": "vite-node scripts/inspect-pwan-gif.ts",
    "pwan:runtime:sync": "node scripts/sync-pwan-runtime-artifacts.mjs",
    "pwan:runtime:check": "node scripts/sync-pwan-runtime-artifacts.mjs --check",
    "pwan:runtime:verify-rom": "vite-node scripts/verify-pwan-rom-compatibility.ts",
    "pwan:runtime:verify-b2-install": "vite-node scripts/verify-black2-pwan-install.ts",
    "pwan:runtime:verify-w2-migration": "vite-node scripts/verify-white2-pwan-migration.ts",
    "battlelog:sync": "node scripts/sync-battle-log-artifact.mjs",
    "battlelog:check": "node scripts/sync-battle-log-artifact.mjs --check",
    "battlelog:verify-rom": "vite-node scripts/verify-battle-log-rom-compatibility.ts",
    "battlelog:verify-bw1-install": "vite-node scripts/verify-bw1-battle-log-install.ts",
    "battlelog:verify-save-patch": "vite-node scripts/verify-w2-battle-log-save-patch.ts",
    "testbattle:enable-animations": "vite-node scripts/enable-test-battle-move-animations.ts",
    "black2upgrade:sync": "node scripts/sync-black2upgrade-artifacts.mjs",
    "black2upgrade:check": "node scripts/sync-black2upgrade-artifacts.mjs --check",
    "black2upgrade:rom": "vite-node scripts/build-black2upgrade-rom.ts",
    "black2upgrade:verify-rom": "vite-node scripts/verify-black2upgrade-rom.ts",
    "mastersheet:move-reference": "python3 scripts/generate_white2upgrade_move_reference.py",
